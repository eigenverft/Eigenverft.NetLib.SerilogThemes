<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Branding>Eigenverft</Branding>
    <!-- Compatibility targets: .NET Framework 4.6.2 plus the .NET LTS lines used by consumers. -->
    <TargetFrameworks>net462;net6.0;net8.0;net10.0</TargetFrameworks>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    <CheckEolTargetFramework>false</CheckEolTargetFramework>
    <OutputType>Library</OutputType>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <DebugType>embedded</DebugType>
    <IsPackable>true</IsPackable>
    <IsPublishable>false</IsPublishable>
    <IsTestProject>false</IsTestProject>
    <VersionBuild>0</VersionBuild>
    <VersionMajor>1</VersionMajor>
    <VersionMinor>0</VersionMinor>
    <VersionRevision>0</VersionRevision>
    <AssemblyVersion>$(VersionBuild).$(VersionMajor).$(VersionMinor).$(VersionRevision)</AssemblyVersion>
    <Version>$(VersionBuild).$(VersionMajor).$(VersionMinor).$(VersionRevision)$(VersionSuffix)</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>$(AssemblyName)</PackageId>
    <Authors>$(Branding)</Authors>
    <RepositoryUrl>https://github.com/eigenverft/Eigenverft.NetLib.SerilogThemes</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/eigenverft/Eigenverft.NetLib.SerilogThemes</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>eigenverft-logo-v7-harbor-square_128_128.png</PackageIcon>
    <Description>Curated ANSI console themes for Serilog, including the Eigenverft dark terminal palette.</Description>
    <PackageTags>dotnet;serilog;console;ansi;theme;logging;eigenverft</PackageTags>
    <Copyright>Copyright (c) 2025-2026 $(Branding)</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../../README.NUGET.md" Pack="true" PackagePath="README.md" />
    <None Include="../../../LICENSE" Pack="true" PackagePath="/" Link="LICENSE" />
    <None Include="AddPackageFiles/eigenverft-logo-v7-harbor-square_128_128.png" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
  </ItemGroup>

</Project>
