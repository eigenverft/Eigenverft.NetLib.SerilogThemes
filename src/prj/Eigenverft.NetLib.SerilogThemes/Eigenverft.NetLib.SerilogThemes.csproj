<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Branding>Eigenverft</Branding>
    <!-- net9.0 consumers use the compatible net8.0 asset; net11.0 remains preview-only. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <OutputType>Library</OutputType>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <DebugType>embedded</DebugType>
    <IsPackable>true</IsPackable>
    <IsPublishable>false</IsPublishable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>$(AssemblyName)</PackageId>
    <Authors>$(Branding)</Authors>
    <RepositoryUrl>https://github.com/eigenverft/Eigenverft.NetLib.SerilogThemes</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Curated ANSI console themes for Serilog, including the Eigenverft dark terminal palette.</Description>
    <PackageTags>dotnet;serilog;console;ansi;theme;logging;eigenverft</PackageTags>
    <Copyright>Copyright (c) 2025 Carsten Riedel; Copyright (c) 2026 $(Branding)</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../../README.md" Pack="true" PackagePath="/" Link="README.md" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
  </ItemGroup>

</Project>
